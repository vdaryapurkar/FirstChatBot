# Copy this file to .env and fill in real values. .env is gitignored --
# never commit actual credentials.
#
# These three variables configure a default connection to an internal AI
# gateway (e.g. a LiteLLM proxy) that exposes Claude models through an
# OpenAI-compatible /chat/completions API. When both AI_API_KEY and
# AI_GATEWAY_ENDPOINT are set, every new browser session defaults to the
# "Open-source / OpenAI-compatible" provider pointed at this gateway,
# instead of the empty Claude fields -- see core/keys.py. The sidebar can
# still override any of this per session.
#
# Leave all three blank (or delete this file's copy) to fall back to the
# plain Claude provider with no default key.

# API key issued by your AI gateway dashboard.
AI_API_KEY=

# Base URL of the gateway's OpenAI-compatible endpoint (no trailing path
# needed beyond what the gateway documents -- passed to the OpenAI SDK's
# base_url as-is).
AI_GATEWAY_ENDPOINT=https://ai-gateway-litellm.example.internal

# Exact model name the gateway exposes for Claude, e.g. claude-haiku-4-5.
AI_GATEWAY_MODEL=claude-haiku-4-5
